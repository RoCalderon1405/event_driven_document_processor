# Docker Compose interpolation only; the application reads process environment.
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE_NAME=document-jobs
AWS_CONNECT_TIMEOUT=2
AWS_READ_TIMEOUT=3
AWS_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
API_PORT=8000
S3_BUCKET_NAME=document-uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_EXPIRES_IN_SECONDS=300
UPLOAD_ALLOWED_CONTENT_TYPES=["application/pdf","image/png","image/jpeg"]
S3_CORS_ALLOWED_ORIGINS=[]
# For host-based development only, explicitly set AWS_ENDPOINT_URL and local dummy
# AWS_ACCESS_KEY_ID=test / AWS_SECRET_ACCESS_KEY=test in your shell. Set
# S3_INTERNAL_ENDPOINT_URL=http://localhost:4566 and S3_PUBLIC_ENDPOINT_URL=http://localhost:4566.
# Inside Compose, provisioning uses http://floci:4566; the API signs for localhost.
# Browser origins must be explicit, e.g. ["http://localhost:3000"], never wildcard.
