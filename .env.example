# Docker Compose interpolation only; the application reads process environment.
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE_NAME=document-jobs
AWS_CONNECT_TIMEOUT=2
AWS_READ_TIMEOUT=3
AWS_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
API_PORT=8000
# For host-based development only, explicitly set AWS_ENDPOINT_URL and local dummy
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in your shell. Floci has no published port
# by default; prefer the Compose API and test service.
